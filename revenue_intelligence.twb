          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
          </pane>
        </panes>
        <rows>[federated.revenue0001].[sum:current_month_revenue:qk]</rows>
        <cols>[federated.revenue0001].[tmn:sales_month:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='MoM Growth'>
      <layout-options>
        <title>
          <formatted-text>
            <run>MoM Growth % (first month has no prior base)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_extract' name='federated.revenue0001' />
          </datasources>
          <datasource-dependencies datasource='federated.revenue0001'>
            <column datatype='real' name='[mom_growth_decimal]' role='measure' type='quantitative' />
            <column datatype='date' name='[sales_month]' role='dimension' type='ordinal' />
            <column datatype='string' name='[growth_direction]' role='dimension' type='nominal' />
            <column-instance column='[mom_growth_decimal]' derivation='Avg' name='[avg:mom_growth_decimal:qk]' pivot='key' type='quantitative' />
            <column-instance column='[sales_month]' derivation='Month-Trunc' name='[tmn:sales_month:qk]' pivot='key' type='quantitative' />
            <column-instance column='[growth_direction]' derivation='None' name='[none:growth_direction:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='text-format' field='[federated.revenue0001].[avg:mom_growth_decimal:qk]' value='0%' />
          </style-rule>
          <style-rule element='mark'>
            <encoding attr='color' field='[federated.revenue0001].[none:growth_direction:nk]' type='palette'>
              <map to='#1f9d55'>
                <bucket>&quot;Growth&quot;</bucket>
              </map>
              <map to='#d64545'>
                <bucket>&quot;Decline&quot;</bucket>
              </map>
              <map to='#9aa5b1'>
                <bucket>&quot;No prior month&quot;</bucket>
              </map>
            </encoding>
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.revenue0001].[none:growth_direction:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.revenue0001].[avg:mom_growth_decimal:qk]</rows>
        <cols>[federated.revenue0001].[tmn:sales_month:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Revenue vs Trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Revenue vs 3-Month Rolling Average</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_extract' name='federated.revenue0001' />
          </datasources>
          <datasource-dependencies datasource='federated.revenue0001'>
            <column datatype='integer' name='[current_month_revenue]' role='measure' type='quantitative' />
            <column datatype='date' name='[sales_month]' role='dimension' type='ordinal' />
            <column datatype='string' name='[vs_rolling_trend]' role='dimension' type='nominal' />
            <column-instance column='[current_month_revenue]' derivation='Sum' name='[sum:current_month_revenue:qk]' pivot='key' type='quantitative' />
            <column-instance column='[sales_month]' derivation='Month-Trunc' name='[tmn:sales_month:qk]' pivot='key' type='quantitative' />
            <column-instance column='[vs_rolling_trend]' derivation='None' name='[none:vs_rolling_trend:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='text-format' field='[federated.revenue0001].[sum:current_month_revenue:qk]' value='#,##0' />
          </style-rule>
          <style-rule element='mark'>
            <encoding attr='color' field='[federated.revenue0001].[none:vs_rolling_trend:nk]' type='palette'>
              <map to='#2f6fed'>
                <bucket>&quot;Above trend&quot;</bucket>
              </map>
              <map to='#f5a623'>
                <bucket>&quot;Below trend&quot;</bucket>
              </map>
              <map to='#9aa5b1'>
                <bucket>&quot;No trend yet&quot;</bucket>
              </map>
            </encoding>
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.revenue0001].[none:vs_rolling_trend:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.revenue0001].[sum:current_month_revenue:qk]</rows>
        <cols>[federated.revenue0001].[tmn:sales_month:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Recent Performance'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Last 3 vs Previous 3 Months (avg revenue)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_extract' name='federated.revenue0001' />
          </datasources>
          <datasource-dependencies datasource='federated.revenue0001'>
            <column datatype='integer' name='[current_month_revenue]' role='measure' type='quantitative' />
            <column datatype='string' name='[period_bucket]' role='dimension' type='nominal' />
            <column-instance column='[current_month_revenue]' derivation='Avg' name='[avg:current_month_revenue:qk]' pivot='key' type='quantitative' />
            <column-instance column='[period_bucket]' derivation='None' name='[none:period_bucket:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.revenue0001].[none:period_bucket:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[period_bucket]' member='&quot;Last 3 months&quot;' />
              <groupfilter function='member' level='[period_bucket]' member='&quot;Previous 3 months&quot;' />
            </groupfilter>
          </filter>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='text-format' field='[federated.revenue0001].[avg:current_month_revenue:qk]' value='#,##0' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.revenue0001].[avg:current_month_revenue:qk]</rows>
        <cols>[federated.revenue0001].[none:period_bucket:nk]</cols>
      </table>
    </worksheet>
  </worksheets>
