  <worksheets>
    <worksheet name='KPI Total Revenue'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Total Revenue</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_extract' name='federated.revenue0001' />
          </datasources>
          <datasource-dependencies datasource='federated.revenue0001'>
            <column datatype='integer' name='[current_month_revenue]' role='measure' type='quantitative' />
            <column-instance column='[current_month_revenue]' derivation='Sum' name='[sum:current_month_revenue:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.revenue0001].[sum:current_month_revenue:qk]' value='#,##0' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column='[federated.revenue0001].[sum:current_month_revenue:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
    </worksheet>
    <worksheet name='KPI Latest Revenue'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Latest Month Revenue</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_extract' name='federated.revenue0001' />
          </datasources>
          <datasource-dependencies datasource='federated.revenue0001'>
            <column datatype='integer' name='[current_month_revenue]' role='measure' type='quantitative' />
            <column datatype='string' name='[latest_flag]' role='dimension' type='nominal' />
            <column-instance column='[current_month_revenue]' derivation='Sum' name='[sum:current_month_revenue:qk]' pivot='key' type='quantitative' />
            <column-instance column='[latest_flag]' derivation='None' name='[none:latest_flag:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.revenue0001].[none:latest_flag:nk]'>
            <groupfilter function='member' level='[latest_flag]' member='&quot;Latest&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.revenue0001].[sum:current_month_revenue:qk]' value='#,##0' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column='[federated.revenue0001].[sum:current_month_revenue:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
    </worksheet>
